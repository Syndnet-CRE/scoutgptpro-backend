{
  "name": "scoutgpt-backend",
  "version": "1.0.0",
  "description": "ScoutGPT Backend API with MapServer Integration",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:local": "dotenv -e .env.local -- node --watch src/server.js",
    "prestart": "prisma generate",
    "start": "node src/server.js",
    "start:local": "dotenv -e .env.local -- node src/server.js",
    "build": "echo 'No build needed'",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:drop-fk": "npx prisma db execute --file scripts/drop-user-fk.sql",
    "seed": "node scripts/seed-mapservers.js",
    "seed:layersets": "node scripts/seed-layer-sets.js",
    "export:parcels:travis": "node scripts/export-parcels-to-mts.mjs",
    "load:parcels:travis": "node scripts/load-parcels-travis.mjs",
    "reload:parcels:travis:ogr": "bash scripts/reload-parcels-travis-ogr.sh",
    "reload:parcels:travis:node": "node scripts/load-parcels-travis.mjs --truncateFirst=true --batchSize=1000 --verify=true --forceNode=true",
    "mts:travis:publish": "node scripts/mts/publish-travis.mjs",
    "mts:travis:studio": "node scripts/mts/ndjson-to-geojson.mjs",
    "ingest:parcels:tx": "node scripts/ingest-parcels-tx.mjs",
    "ingest:parcels:tx:travis": "node scripts/ingest-parcels-tx.mjs --countyFips=48453",
    "ingest:txgio:travis": "bash scripts/ingest-txgio-travis.sh",
    "ingest:travis:enrichment": "node scripts/ingest-travis-enrichment.mjs",
    "ingest:travis:enrichment:local": "node scripts/ingest-travis-enrichment-local.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@prisma/client": "^6.1.0",
    "@turf/turf": "^7.3.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "papaparse": "^5.4.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "prisma": "^6.1.0",
    "proj4": "^2.20.2",
    "replicate": "^1.4.0",
    "shapefile": "^0.6.6",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "csv-parser": "^3.2.0",
    "dotenv-cli": "^11.0.0"
  }
}
